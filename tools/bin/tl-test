#!/data/data/com.termux/files/usr/bin/bash
set -e

ROOT="$HOME/projects/truth-lens"
API_LOG="$ROOT/.tl-api-test.log"

cleanup() {
  if [ -n "$API_PID" ] && kill -0 "$API_PID" 2>/dev/null; then
    kill "$API_PID" 2>/dev/null || true
    wait "$API_PID" 2>/dev/null || true
  fi
}

trap cleanup EXIT

cd "$ROOT"

echo "[1/6] Running worker..."
node apps/worker/src/worker.ts

echo "[2/6] Starting API..."
node apps/api/src/server.ts > "$API_LOG" 2>&1 &
API_PID=$!

sleep 2

echo "[3/6] Checking /health ..."
curl -fsS http://127.0.0.1:3001/health
echo
echo

echo "[4/6] Checking /posts ..."
curl -fsS http://127.0.0.1:3001/posts
echo
echo

echo "[5/6] Checking /analysis ..."
curl -fsS http://127.0.0.1:3001/analysis
echo
echo

echo "[6/6] Checking /summary ..."
curl -fsS http://127.0.0.1:3001/summary
echo
echo

echo "[ok] tl-test passed"
