echo

echo "--- COMPARE (COMPACT) ---"
PYTHONPATH="$ROOT" python -B -m sim.tools.compare_compact || true
echo

echo "--- DRIFT ---"
PYTHONPATH="$ROOT" python -B -m sim.observatory.drift_report || true
